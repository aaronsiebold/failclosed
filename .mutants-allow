# Known equivalent mutants: changes that no input can distinguish.
#
# Format:  <path> :: <source line> :: <original>-><replacement>  # reason
#
# Keyed on the source line rather than a line number on purpose — a
# line-numbered allow-list starts excusing a different mutant the moment
# someone adds an import above it.
#
# Anything NOT listed here fails the build. Add an entry only when you can say
# why no test could ever catch it. "Hard to test" is not a reason.

failclosed/evals.py :: json.dump(payload, fh, indent=2, sort_keys=True) :: True->False  # sort_keys changes key order in the serialised JSON, not behaviour; the file round-trips identically either way
failclosed/ledger.py :: return json.dumps({"key": self.key, "at": self.at, "meta": self.meta}, sort_keys=True) :: True->False  # as above: byte order of a serialised entry, not behaviour
